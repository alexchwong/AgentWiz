{
  "format_version": 1,
  "name": "echo_numbers",
  "description": "Send two exact numbers to a tool and check what comes back.",
  "inputs": {"id": {"contract": {"format": "json"}}, "ratio": {"contract": {"format": "json"}}},
  "outputs": {"fields": {"contract": "fields"}},
  "steps": [
    {"id": "echo", "kind": "tool", "server": "tutorial", "tool": "numbers",
     "arguments": {"id": "{{inputs.id}}", "ratio": "{{inputs.ratio}}"},
     "output": "fields"}
  ]
}
