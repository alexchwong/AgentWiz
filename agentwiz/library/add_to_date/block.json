{
  "format_version": 4,
  "name": "add_to_date",
  "description": "Add months and days to an ISO date.",
  "inputs": {
    "date": {
      "contract": {
        "format": "text",
        "max_length": 10
      },
      "local_only": false
    },
    "months": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "integer",
          "minimum": -119988,
          "maximum": 119988
        }
      },
      "local_only": false
    },
    "days": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "integer",
          "minimum": -3652425,
          "maximum": 3652425
        }
      },
      "local_only": false
    }
  },
  "outputs": {
    "out": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "maxLength": 10
            },
            "clamped": {
              "type": "boolean"
            },
            "days": {
              "type": "integer",
              "minimum": -3652425,
              "maximum": 3652425
            },
            "weekday": {
              "type": "string",
              "maxLength": 16
            },
            "iso_weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "additionalProperties": false,
          "required": []
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "run",
      "kind": "tool",
      "builtin": "date_arithmetic",
      "output": "out",
      "arguments": {
        "operation": "add",
        "date": "{{inputs.date}}",
        "months": "{{inputs.months}}",
        "days": "{{inputs.days}}"
      }
    }
  ]
}
