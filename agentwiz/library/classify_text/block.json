{
  "format_version": 4,
  "name": "classify_text",
  "description": "Choose one label from a list for a short text, with a reason.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 8000
      },
      "local_only": false
    },
    "labels": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 2
        }
      },
      "local_only": false
    }
  },
  "outputs": {
    "label": {
      "contract": {
        "format": "text",
        "max_length": 100
      },
      "local_only": false
    },
    "reason": {
      "contract": {
        "format": "text",
        "max_length": 300
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 512
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
