{
  "format_version": 4,
  "name": "draft_reply",
  "description": "Draft a reply to a message covering given points, in a chosen tone.",
  "inputs": {
    "message": {
      "contract": {
        "format": "text",
        "max_length": 8000
      },
      "local_only": false
    },
    "points": {
      "contract": {
        "format": "text",
        "max_length": 4000
      },
      "local_only": false
    },
    "tone": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "string",
          "enum": [
            "neutral",
            "warm",
            "firm"
          ]
        }
      },
      "local_only": false
    }
  },
  "outputs": {
    "reply": {
      "contract": {
        "format": "text",
        "max_length": 6000
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 2048
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
