{
  "format_version": 4,
  "name": "summarise_document",
  "description": "Summarise a document at a chosen length, with key points.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 40000
      },
      "local_only": false
    },
    "length": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long"
          ]
        }
      },
      "local_only": false
    }
  },
  "outputs": {
    "summary": {
      "contract": {
        "format": "text",
        "max_length": 3000
      },
      "local_only": false
    },
    "key_points": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 2048
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
