{
  "format_version": 4,
  "name": "extract_action_items",
  "description": "List the action items in notes, with owner and due date if stated.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 40000
      },
      "local_only": false
    }
  },
  "outputs": {
    "items": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string",
                "maxLength": 300
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "due": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              }
            },
            "required": [
              "task",
              "owner",
              "due"
            ],
            "additionalProperties": false
          }
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 6144
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
