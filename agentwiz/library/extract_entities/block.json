{
  "format_version": 4,
  "name": "extract_entities",
  "description": "List the people, organisations, dates and places a text mentions.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 40000
      },
      "local_only": false
    }
  },
  "outputs": {
    "people": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "local_only": false
    },
    "organisations": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "local_only": false
    },
    "dates": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "local_only": false
    },
    "places": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 4096
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
