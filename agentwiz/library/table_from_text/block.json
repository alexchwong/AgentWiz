{
  "format_version": 4,
  "name": "table_from_text",
  "description": "Extract rows for given columns from a text.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 20000
      },
      "local_only": false
    },
    "columns": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1
        }
      },
      "local_only": false
    }
  },
  "outputs": {
    "rows": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "minItems": 1
          }
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 6144
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
