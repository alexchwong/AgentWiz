  "description": {
    "sections": {
      "use": "Give a workflow the current local date and time in an IANA time zone such as Europe/Paris.",
      "exclusions": "Not for date arithmetic; use add_to_date or days_between_dates.",
      "limitations": "Reads this computer's clock. The zone must be an IANA name; abbreviations such as EST are refused.",
      "missing_data": "Always returns a value for a known zone.",
      "effects": "Runs locally inside AgentWiz with no network access, files or model; it only returns a value. It has no destination, so it can run on Local only data; its output is restricted whenever an input is.",
      "failures": "A refusal names a fixed code and, where it applies, a 1-based position (record, row or entry); the message never repeats your text. Check the input against the limits above and run again."
    },
    "port_summaries": {
      "inputs": {
        "timezone": "An IANA time zone name, such as UTC or Australia/Sydney."
      },
      "outputs": {
        "out": "local and UTC times, the zone, its UTC offset and the weekday."
      }
    }
  }
