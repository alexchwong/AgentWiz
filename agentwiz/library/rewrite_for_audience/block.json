{
  "format_version": 4,
  "name": "rewrite_for_audience",
  "description": "Rewrite a text for a stated audience, keeping every fact.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 20000
      },
      "local_only": false
    },
    "instruction": {
      "contract": {
        "format": "text",
        "max_length": 500
      },
      "local_only": false
    }
  },
  "outputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 20000
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 6144
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
