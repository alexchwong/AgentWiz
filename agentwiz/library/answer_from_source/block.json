{
  "format_version": 4,
  "name": "answer_from_source",
  "description": "Answer a question only from a given source, with quotes.",
  "inputs": {
    "question": {
      "contract": {
        "format": "text",
        "max_length": 1000
      },
      "local_only": false
    },
    "source": {
      "contract": {
        "format": "text",
        "max_length": 40000
      },
      "local_only": false
    }
  },
  "outputs": {
    "found": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "boolean"
        }
      },
      "local_only": false
    },
    "answer": {
      "contract": {
        "format": "text",
        "max_length": 2000
      },
      "local_only": false
    },
    "quotes": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 1536
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
