{
  "format_version": 4,
  "name": "translate_text",
  "description": "Translate a text into a target language, keeping Markdown and numbers.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 20000
      },
      "local_only": false
    },
    "target_language": {
      "contract": {
        "format": "text",
        "max_length": 50
      },
      "local_only": false
    }
  },
  "outputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 40000
      },
      "local_only": false
    },
    "source_language": {
      "contract": {
        "format": "text",
        "max_length": 50
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 8192
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
