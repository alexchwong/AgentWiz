{
  "format_version": 4,
  "name": "proofread",
  "description": "Correct spelling, grammar and punctuation, listing each change.",
  "inputs": {
    "text": {
      "contract": {
        "format": "text",
        "max_length": 20000
      },
      "local_only": false
    }
  },
  "outputs": {
    "corrected": {
      "contract": {
        "format": "text",
        "max_length": 20000
      },
      "local_only": false
    },
    "changes": {
      "contract": {
        "format": "json",
        "schema": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "maxLength": 200
              },
              "after": {
                "type": "string",
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "maxLength": 150
              }
            },
            "required": [
              "before",
              "after",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "local_only": false
    }
  },
  "steps": [
    {
      "id": "request",
      "kind": "model",
      "role": "fast",
      "system": {
        "file": "prompts/system.md"
      },
      "prompt": {
        "file": "prompts/user.md"
      },
      "response_mode": "named_json",
      "task": {
        "max_tokens": 8192
      },
      "repair": {
        "max_repairs": 2
      }
    }
  ],
  "budget": {
    "max_seconds": 180
  }
}
