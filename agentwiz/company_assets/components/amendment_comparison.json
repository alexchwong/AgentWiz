                  "records": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "document": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "authority": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "date": {
