                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 100
                  },
                  "unknowns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 100
                  },
                  "regression_check": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "quotes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "primary_cause",
                  "follow_on",
                  "unknowns",
                  "regression_check",
                  "quotes"
