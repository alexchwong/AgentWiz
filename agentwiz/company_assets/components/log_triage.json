                  "records": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "time": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "event": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        }
