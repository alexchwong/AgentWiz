{
  "format": "agentwiz.component",
  "format_version": 1,
  "root": {
    "kind": "workflow",
    "id": "company/criteria_evidence",
    "title": "Check whether evidence is complete",
    "visibility": "private",
    "category": "analysis",
    "definition": {
      "workflow": {
        "name": "criteria_evidence",
        "purpose": "Check supplied evidence against every stated requirement.",
        "inputs": {
          "source": {
            "contract": {
              "format": "text",
              "max_length": 32768
            },
            "local_only": false
          }
        },
        "outputs": {
          "criteria": {
            "contract": {
              "format": "json",
              "schema": {
                "type": "object",
                "properties": {
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "criterion": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "met",
                            "unmet",
                            "unknown"
                          ]
                        },
                        "quote": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "minLength": 1,
                          "maxLength": 2000
                        }
                      },
                      "required": [
                        "criterion",
                        "status",
                        "quote"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 100
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "rows",
                  "complete"
                ],
                "additionalProperties": false
              }
            },
            "local_only": false,
            "binding": {
              "kind": "node",
              "node": "reduce",
              "port": "out"
