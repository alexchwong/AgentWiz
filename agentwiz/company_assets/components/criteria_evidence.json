                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "criterion": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2000
                                },
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "met",
                                    "unmet",
                                    "unknown"
                                  ]
                                },
                                "quote": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
