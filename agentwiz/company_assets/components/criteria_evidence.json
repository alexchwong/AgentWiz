                    },
                    "local_only": false
                  }
                },
                "outputs": {
                  "out": {
                    "contract": {
                      "format": "json",
                      "schema": {
                        "type": "object",
                        "properties": {
                          "rows": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "criterion": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2000
                                },
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "met",
                                    "unmet",
                                    "unknown"
                                  ]
                                },
                                "quote": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "minLength": 1,
                                  "maxLength": 2000
                                }
                              },
                              "required": [
                                "criterion",
                                "status",
                                "quote"
