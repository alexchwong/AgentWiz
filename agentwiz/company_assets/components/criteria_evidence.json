          "reduce": {
            "block": "reduce",
            "bindings": {
              "records": {
                "kind": "node",
                "node": "extract",
                "port": "out",
                "path": [
                  "records"
                ]
              }
            }
          }
        }
      },
      "blocks": {
        "extract": {
          "inline": {
            "kind": "block",
            "id": "company/extract_criteria_evidence",
            "title": "Extract criteria evidence",
            "visibility": "private",
            "category": "analysis",
            "definition": {
              "block": {
                "format_version": 4,
                "name": "extract_criteria_evidence",
                "inputs": {
                  "source": {
                    "contract": {
                      "format": "text",
