                    "local_only": false
                  }
                },
                "steps": [
                  {
                    "id": "run",
                    "kind": "transform",
                    "operation": "reduce_coverage",
                    "operation_version": 1,
                    "parameters": {
                      "key": "criterion",
                      "status": "status",
                      "evidence": "quote",
                      "positive": "met",
                      "unknown": "unknown"
                    },
                    "output": "out"
                  }
                ]
              }
            }
          }
        }
      },
      "layout": {
        "extract": {
